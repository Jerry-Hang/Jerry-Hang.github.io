[Unit]
Description=Jerry Blog Server (VPS)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/blog
Environment=BLOG_ROOT=/opt/blog/frontend
Environment=BLOG_DB=/opt/blog/blog.db
Environment=BLOG_CONFIG=/opt/blog/config.toml
Environment=BLOG_EXT_ADDR=0.0.0.0:80
Environment=BLOG_LOCAL_ADDR=none
Environment=BLOG_WORKERS=2
Environment=BLOG_CPUS=0
ExecStart=/opt/blog/target/release/blog_server
Restart=always
RestartSec=3
# 内存约束：400M 软限触发回收与降级，448M 为系统硬上限（超出由内核 OOM 兜底）
MemoryHigh=400M
MemoryMax=448M

[Install]
WantedBy=multi-user.target
